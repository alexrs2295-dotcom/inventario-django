[Unit]
Description=Inventario (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/inventario-django
EnvironmentFile=/srv/inventario-django/.env
ExecStart=/srv/inventario-django/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8102 --workers 3
Restart=on-failure

[Install]
WantedBy=multi-user.target
